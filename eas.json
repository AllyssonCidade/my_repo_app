{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview3": {
      "developmentClient": true
    },
    "preview4": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {}
  },
  "submit": {
    "staging": {
      "android": {
        "serviceAccountKeyPath": "./path/to/google-services.json",
        "track": "internal"
      }
    }
  }
}
